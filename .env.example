# ===================================================================
# LearnSphere Platform — Environment Template (.env.example)
# Copy this file to .env and fill in your values
# ===================================================================

# ── Flask & Authentication Security ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# ── Flask Environment ──────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# ── Groq AI Tutor API Key ──────────────────────────────────────────
# Free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Database Configuration ─────────────────────────────────────────
# Leave empty for local SQLite (learnsphere.db).
# For Cloud PostgreSQL (Neon / Supabase / Render):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
